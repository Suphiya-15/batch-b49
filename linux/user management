usermod -u <new-uid> <user-name>
--> to change user's uid
usermod -u 7001 seema

usermod -g <new-gid> <user_name>
--> to change user's gid
usermod -g 1001 seema

usermod -c "comments" <user_name>
--> to update user information
usermod -c "seema patil, Pune, 0123456789" seema

usermod -d <new-home-dir> <user_name>
--> to change user's home directory
usermod -d /mnt seema

usermod -s <new-shell_type> <user_name>
--> to chnage shell type
usermod -s /bin/sh seema

usermod -l <new_name> <old_user_name>
--> to rename user
usermod -l seema seeema

usermod -L <user_name>
-> to lock user account
usemod -L seema

usermod -U <user_name>
--> to unlock user account
usermod -U seema

